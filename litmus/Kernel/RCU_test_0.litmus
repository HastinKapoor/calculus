C RCU_test_0

// Sometimes: writes before the sync can be reordered, and a "partial" update can be seen (only one of the two writes is visible during the read lock)

{
int x = 1;
int *y = &x;
int z = 1;
}

P0(int *x, int *z, int **y)
{
	int *r0;
	int r1;

	rcu_read_lock();
	r0 = rcu_dereference(*y);
	r1 = READ_ONCE(*r0);
	rcu_read_unlock();
}

P1(int *x, int *z, int **y)
{
	rcu_assign_pointer(*y, z);
//	synchronize_rcu(); // This prevents reordering
	WRITE_ONCE(*x, 0);
	synchronize_rcu();
}

exists (0:r0=x /\ 0:r1=0)
