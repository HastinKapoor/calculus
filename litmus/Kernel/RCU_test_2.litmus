C RCU_test_2

{}

P0(int *x, int *y, int *z)
{
	rcu_read_lock();
	WRITE_ONCE(*x, 1);
	WRITE_ONCE(*y, 1);
	rcu_read_unlock();
}

P1(int *x, int *y, int *z)
{
	rcu_read_lock();
	int r0 = READ_ONCE(*y);
	WRITE_ONCE(*z, 1);
	rcu_read_unlock();
}

P2(int *x, int *y, int *z)
{
	int r0 = READ_ONCE(*z);
	synchronize_rcu();
	int r1 = READ_ONCE(*x);
}

exists (2:r0=1 /\ 2:r1=0)
