C RCU_non_sc

{}

P0(int *x, int *y)
{
	int r0;
	int r1;

	rcu_read_lock();
	r0 = READ_ONCE(*x);
	rcu_read_lock();

	rcu_read_unlock();
	r1 = READ_ONCE(*y);
	rcu_read_unlock();
}

P1(int *x, int *y)
{	
	rcu_read_lock();
	WRITE_ONCE(*x, 1);
	rcu_read_lock();

	rcu_read_lock();
	WRITE_ONCE(*y, 1);
	rcu_read_lock();
}

exists (0:r0=0 /\ 0:r1=1)
