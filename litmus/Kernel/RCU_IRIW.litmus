C RCU_IRIW

{}

P0(int *x, int *y)
{
	int r0;
	int r1;

	rcu_read_lock();
	int* p = rcu_dereference(*x);
	r0 = READ_ONCE(*p);
	int* q = rcu_dereference(*y);
	r1 = READ_ONCE(*q);
	rcu_read_unlock();
}

P1(int *x, int *y)
{
	int r0;
	int r1;
	
	r0 = READ_ONCE(*x);
	synchronize_rcu();
	r1 = READ_ONCE(*y);
}

P2(int *x, int *y)
{
	WRITE_ONCE(*x, 1);
}

P3(int *x, int *y)
{
	WRITE_ONCE(*y, 1);
}

exists (0:r0=1 /\ 0:r1=0 /\ 1:r0=0 /\ 1:r1=1)
