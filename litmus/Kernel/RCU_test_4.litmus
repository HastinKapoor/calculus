C RCU_test_4

{}

P0(int *x, int *y)
{
//	*x = 1;
	WRITE_ONCE(*x, 1);
}

P1(int *x, int *y)
{
	rcu_read_lock();
	int r0 = READ_ONCE(*x);
	WRITE_ONCE(*y, 1);
	rcu_read_unlock();
}

P2(int *x, int *y)
{
	int r0 = READ_ONCE(*y);
	synchronize_rcu();
	int r1 = READ_ONCE(*x);
}

exists (1:r0=1 /\ 2:r0=1 /\ 2:r1=0)
