{}

P0(int *x, int *y, spinlock_t *mylock){
Read(mylock, 0, LOCK_READ, Linux, None);
	Write(mylock, 1, LOCK_WRITE, Linux, None);
	Write(x, 1, Relaxed, Linux, None);
	Write(y, 1, Relaxed, Linux, None);
	Write(mylock, 0, UNLOCK, Linux, None);
}

P1(int *y, int *z, spinlock_t *mylock){

	Read(mylock, 0, LOCK_READ, Linux, None);
	Write(mylock, 1, LOCK_WRITE, Linux, None);
	Read(y, None, Relaxed, Linux, r0_T1);
	Write(z, 1, Relaxed, Linux, None);
	Write(mylock, 0, UNLOCK, Linux, None);
}

P2(int *x, int *z){

	Read(z, None, Relaxed, Linux, r2_T2);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(x, None, Relaxed, Linux, r1_T2);
}

exists (r0_T1=1 /\ r2_T2=1 /\ r1_T2=0)
