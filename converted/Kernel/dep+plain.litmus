P0(int *x, int *y, int *z1, int *z2){
Read(x, None, Relaxed, Linux, a);
	Write(z1, a, Relaxed, C, None);
	Read(z1, None, Relaxed, C, plain_tmp_0);
	Write(z2, plain_tmp_0, Relaxed, C, None);
