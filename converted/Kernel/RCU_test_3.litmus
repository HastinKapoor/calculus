{}

P0(int *x, int *y){
Read(x, None, Relaxed, Linux, r0_T0);
	Write(y, 1, Release, Linux, None);
	Fence(None, None, SYNC_RCU, Linux, None);
}

P1(int *x, int *y){
Fence(None, None, RCU_LOCK, Linux, None);
	Read(y, None, Relaxed, Linux, r0_T1);
	Write(x, 1, Relaxed, Linux, None);
	Fence(None, None, RCU_UNLOCK, Linux, None);
}

exists (r0_T0=1 /\ r0_T1=1)
