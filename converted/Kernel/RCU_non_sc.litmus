{}

P0(int *x, int *y){

	Fence(None, None, RCU_LOCK, Linux, None);
	Read(x, None, Relaxed, Linux, r0_T0);
	Fence(None, None, RCU_LOCK, Linux, None);

	Fence(None, None, RCU_UNLOCK, Linux, None);
	Read(y, None, Relaxed, Linux, r1_T0);
	Fence(None, None, RCU_UNLOCK, Linux, None);
}

P1(int *x, int *y){
Fence(None, None, RCU_LOCK, Linux, None);
	Write(x, 1, Relaxed, Linux, None);
	Fence(None, None, RCU_LOCK, Linux, None);

	Fence(None, None, RCU_LOCK, Linux, None);
	Write(y, 1, Relaxed, Linux, None);
	Fence(None, None, RCU_LOCK, Linux, None);
}

exists (r0_T0=0 /\ r1_T0=1)
