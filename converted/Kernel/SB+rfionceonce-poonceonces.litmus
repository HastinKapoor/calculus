{}

P0(int *x, int *y){

	Write(x, 1, Relaxed, Linux, None);
	Read(x, None, Relaxed, Linux, r1_T0);
	Read(y, None, Relaxed, Linux, r2_T0);
}

P1(int *x, int *y){

	Write(y, 1, Relaxed, Linux, None);
	Read(y, None, Relaxed, Linux, r3_T1);
	Read(x, None, Relaxed, Linux, r4_T1);
}

locations [0:r1_T0; 1:r3_T1; x; y] (* Debug aid: Print things not in "exists". *)
exists (r2_T0=0 /\ r4_T1=0)
