{}

P0(int *buf, int *flag, spinlock_t *mylock){

	Read(*flag, None, Relaxed, Linux, r0);
	spin_lock(mylock);
	Read(*buf, None, Relaxed, Linux, r1);
	spin_unlock(mylock);
}

P1(int *buf, int *flag, spinlock_t *mylock){
spin_lock(mylock);
	Write(*buf, 1, Relaxed, Linux, None);
	spin_unlock(mylock);
	Write(*flag, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r1=0)
