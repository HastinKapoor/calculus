{}

P0(int *buf, int *flag, spinlock_t *mylock){

	Read(flag, None, Relaxed, Linux, r0_T0);
	Read(mylock, 0, LOCK_READ, Linux, None);
	Write(mylock, 1, LOCK_WRITE, Linux, None);
	Read(buf, None, Relaxed, Linux, r1_T0);
	Write(mylock, 0, UNLOCK, Linux, None);
}

P1(int *buf, int *flag, spinlock_t *mylock){
Read(mylock, 0, LOCK_READ, Linux, None);
	Write(mylock, 1, LOCK_WRITE, Linux, None);
	Write(buf, 1, Relaxed, Linux, None);
	Write(mylock, 0, UNLOCK, Linux, None);
	Write(flag, 1, Relaxed, Linux, None);
}

exists (r0_T0=1 /\ r1_T0=0)
