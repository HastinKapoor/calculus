{ int x = 1; int *y = &x; int z = 1; }

P0(int *x, int *z, int **y){

	Fence(None, None, RCU_LOCK, Linux, None);
	Read(y, None, Relaxed, Linux, r0_T0);
	Read(r0_T0, None, Relaxed, Linux, r1_T0);
	Fence(None, None, RCU_UNLOCK, Linux, None);
}

P1(int *x, int *z, int **y){
Write(y, z, Release, Linux, None);

	Write(x, 0, Relaxed, Linux, None);
	Fence(None, None, SYNC_RCU, Linux, None);
}

exists (r0_T0=x /\ r1_T0=0)
