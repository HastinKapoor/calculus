{}

P0(int *x, int *y, int *z){
Fence(None, None, RCU_LOCK, Linux, None);
	Read(y, None, Relaxed, Linux, r0_T0);
	Write(x, 1, Relaxed, Linux, None);
	Fence(None, None, RCU_UNLOCK, Linux, None);
}

P1(int *x, int *y, int *z){
Read(x, None, Relaxed, Linux, r0_T1);
	Fence(None, None, SYNC_RCU, Linux, None);
	Write(z, 1, Relaxed, Linux, None);
}

P2(int *x, int *y, int *z){
Fence(None, None, RCU_LOCK, Linux, None);
	Read(z, None, Relaxed, Linux, r0_T2);
	Write(y, 1, Relaxed, Linux, None);
	Fence(None, None, RCU_UNLOCK, Linux, None);
}

exists (r0_T0=1 /\ r0_T1=1 /\ r0_T2=1)
