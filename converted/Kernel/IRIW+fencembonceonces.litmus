P0(int *x) {
	Write(x, 1, Relaxed, Linux, None);
}

P1(int *x, int *y) {
	Read(x, None, Relaxed, Linux, r0);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(y, None, Relaxed, Linux, r1);
}

P2(int *y) {
	Write(y, 1, Relaxed, Linux, None);
}

P3(int *x, int *y) {
	Read(y, None, Relaxed, Linux, r2);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(x, None, Relaxed, Linux, r3);
}

exists (r0=1 /\ r1=0 /\ r2=1 /\ r3=0)
