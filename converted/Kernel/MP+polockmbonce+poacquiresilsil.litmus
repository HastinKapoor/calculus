{}

P0(spinlock_t *lo, int *x){
Read(lo, 0, LOCK_READ, Linux, None);
	Write(lo, 1, LOCK_WRITE, Linux, None);
	Fence(None, None, AFTER_SPINLOCK, Linux, None);
	Write(x, 1, Relaxed, Linux, None);
	Write(lo, 0, UNLOCK, Linux, None);
}

P1(spinlock_t *lo, int *x){

	Read(x, None, Acquire, Linux, r1_T1);
	Read(lo, None, Relaxed, Linux, r2_T1);
	Read(lo, None, Relaxed, Linux, r3_T1);
}

exists (r1_T1=1 /\ r2_T1=0 /\ r3_T1=1)
