{ int x = 1; int *y = &x; int z = 1; }

P0(int *x, int *z, int **y){

	rcu_read_lock();
	r0 = rcu_dereference(*y);
	Read(r0, None, Relaxed, Linux, r1);
	rcu_read_unlock();
}

P1(int *x, int *z, int **y){
rcu_assign_pointer(*y, z);

	Write(x, 0, Release, Linux, None);
	synchronize_rcu();
}

exists (r0=x /\ r1=0)
