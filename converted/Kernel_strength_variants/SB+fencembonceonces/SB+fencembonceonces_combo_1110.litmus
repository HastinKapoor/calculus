{}

P0(int *x, int *y){

	Write(x, 1, Relaxed, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(y, None, Acquire, Linux, r0_T0);
}

P1(int *x, int *y){

	Write(y, 1, Release, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(x, None, Acquire, Linux, r0_T1);
}

exists (r0_T0=0 /\ r0_T1=0)
