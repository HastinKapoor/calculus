{}

P0(int *x, int *y){

	Read(x, None, Acquire, Linux, r0_T0);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(y, 1, Relaxed, Linux, None);
}

P1(int *x, int *y){

	Read(y, None, Acquire, Linux, r0_T1);
	if(r0_T1 == 1){
		Write(x, 1, Relaxed, Linux, None);
} else {
		Write(x, 1, Release, Linux, None);
	}
}

exists (r0_T0=1 /\ r0_T1=1)
