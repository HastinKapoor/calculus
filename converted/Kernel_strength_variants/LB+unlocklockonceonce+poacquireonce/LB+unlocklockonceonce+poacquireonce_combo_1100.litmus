{}

P0(spinlock_t *s, spinlock_t *t, int *x, int *y){

	spin_lock(s);
	Read(x, None, Relaxed, Linux, r1);
	spin_unlock(s);
	spin_lock(t);
	Write(y, 1, Relaxed, Linux, None);
	spin_unlock(t);
}

P1(int *x, int *y){

	Read(y, None, Acquire, Linux, r2);
	Write(x, 1, Release, Linux, None);
}

exists (r1=1 /\ r2=1)
