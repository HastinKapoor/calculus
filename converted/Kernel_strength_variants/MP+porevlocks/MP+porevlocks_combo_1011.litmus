{}

P0(int *buf, int *flag, spinlock_t *mylock){

	Read(flag, None, Acquire, Linux, r0);
	spin_lock(mylock);
	Read(buf, None, Acquire, Linux, r1);
	spin_unlock(mylock);
}

P1(int *buf, int *flag, spinlock_t *mylock){
spin_lock(mylock);
	Write(buf, 1, Relaxed, Linux, None);
	spin_unlock(mylock);
	Write(flag, 1, Release, Linux, None);
}

exists (r0=1 /\ r1=0)
