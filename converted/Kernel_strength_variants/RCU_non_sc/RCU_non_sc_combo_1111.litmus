{}

P0(int *x, int *y){

	rcu_read_lock();
	Read(x, None, Acquire, Linux, r0);
	rcu_read_lock();

	rcu_read_unlock();
	Read(y, None, Acquire, Linux, r1);
	rcu_read_unlock();
}

P1(int *x, int *y){
rcu_read_lock();
	Write(x, 1, Release, Linux, None);
	rcu_read_lock();

	rcu_read_lock();
	Write(y, 1, Release, Linux, None);
	rcu_read_lock();
}

exists (r0=0 /\ r1=1)
