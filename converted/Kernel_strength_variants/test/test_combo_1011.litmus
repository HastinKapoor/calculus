C SB+fencembonceonces

(*
 * Result: Never
 *
 * This litmus test demonstrates that full memory barriers suffice to
 * order the store-buffering pattern, where each process writes to the
 * variable that the preceding process reads.  (Locking and RCU can also
 * suffice, but not much else.)
 *)

{}

P0(int *x, int *y) {
	

	Write(*x, 1, Release, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(*y, None, Acquire, Linux, r0);
}

P1(int *x, int *y) {
	

	Write(*y, 1, Relaxed, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(*x, None, Acquire, Linux, r1);
}

exists (r0=0 /\ r1=0)
