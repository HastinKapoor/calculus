{}

P0(int *a){
Write(a, 1, Relaxed, Linux, None);
}

P1(int *a, int *b){

	Read(a, None, Relaxed, Linux, r1_T1);
	Fence(None, None, SYNC_RCU, Linux, None);
	Write(b, 1, Relaxed, Linux, None);
}

P2(int *a, int *b, int *c){

	Fence(None, None, RCU_LOCK, Linux, None);
	Read(b, None, Relaxed, Linux, r1_T2);
	Write(c, 1, Relaxed, Linux, None);
	Fence(None, None, RCU_UNLOCK, Linux, None);
}

P3(int *a, int *c){

	Read(c, None, Relaxed, Linux, r1_T3);
	if (r1_T3)
		Read(a, None, Relaxed, Linux, r2);
}

exists (r1_T1=1 /\ r1_T2=1 /\ r1_T3=1 /\ r2=0)
