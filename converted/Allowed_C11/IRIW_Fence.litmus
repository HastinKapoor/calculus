P0 (atomic_int* x, atomic_int* y){
  Write(x, 1, Relaxed, C);
}

P1 (atomic_int* x, volatile int* y){
  Read(y, None, Relaxed, C, r0);
  Fence(None, None, SEQ_CST, C);
  Read(x, None, Relaxed, C, r1);
}

P2 (atomic_int* x, volatile int* y){
  Read(x, None, Relaxed, C, r2);
  Fence(None, None, SEQ_CST, C);
  Read(y, None, Relaxed, C, r3);
}

P3 (atomic_int* x, atomic_int* y){
  Write(y, 1, Relaxed, C);
}

exists(r0=1 /\ r1=0 /\ r2=1 /\ r3=0)
