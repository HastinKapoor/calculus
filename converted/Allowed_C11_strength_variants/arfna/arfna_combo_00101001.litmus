P0 (atomic_int* x, atomic_int* y){
  Read(x, None, Acquire, C, r0);
  Read(a, None, Relaxed, C, t);
  Write(b, 1, Relaxed, C);
  Write(y, 1, Release, C);
}

P1 (atomic_int* x, atomic_int* y){
  Read(y, None, Relaxed, C, r1);
  Read(b, None, Acquire, C, if_b)
  Write(a, 1, Relaxed, C);
  Write(x, 1, Relaxed, C);
}

exists (x=1 /\ y=1 /\ r0=1 /\ t=1 /\ r1=0 /\ if_b=1)
