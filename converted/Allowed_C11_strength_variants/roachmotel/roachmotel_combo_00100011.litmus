P0 (volatile int* a, atomic_int* z) {
  Write(z, 1, Release, C);
  Write(a, 1, Release, C);
}

P1 (volatile int* a, atomic_int* x, atomic_int* y, atomic_int* z) {
  Read(x, None, Relaxed, C, r0);
  Read(z, None, Relaxed, C, r1);
  Read(a, None, Relaxed, C, r2);
  Write(y, 1, Release, C);
}

P2 (atomic_int* x, atomic_int* y) {
  Read(y, None, Relaxed, C, r3);
  Write(x, 1, Relaxed, C);
}

exists (a=1 /\ z=1 /\ x=1 /\ y=1 /\ r0=1 /\ r2=1 /\ r3=1)
