P0 (volatile int* a) {
  Write(a, 1, Release, C);
}

P1 (volatile int* a, atomic_int* x, atomic_int* y) {
  Read(x, None, Acquire, C, r0);
  Read(a, None, Relaxed, C, r1);
  Write(y, 1, Relaxed, C);
}

P2 (atomic_int* x, atomic_int* y) {
  Read(y, None, Relaxed, C, r2);
  Write(x, 1, Relaxed, C);
}

exists (a=1 /\ x=1 /\ y=1 /\ r0=1 /\ r1=1 /\ r2=1)
