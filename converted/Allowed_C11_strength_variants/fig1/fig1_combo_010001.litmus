P0 (volatile int* a, atomic_int* x, atomic_int* y) {
  Write(a, 1, Release, C);
  Read(x, None, Relaxed, C, r0);
  Read(a, None, Relaxed, C, r1);
  Write(y, 1, Relaxed, C);
}

P1 (atomic_int* x, atomic_int* y) {
  Read(y, None, Acquire, C, r2);
  Write(x, 1, Relaxed, C);
}

exists (a=1 /\ x=1 /\ y=1)