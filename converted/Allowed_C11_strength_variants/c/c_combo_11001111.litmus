P0 (atomic_int *x, atomic_int *y, volatile int* p, volatile int* q) {
  Read(x, None, Acquire, C, r0);
  Read(p, None, Acquire, C, t);
  Write(q, 1, Release, C);
  Write(y, 1, Release, C);
}

P1 (atomic_int *x, atomic_int *y, volatile int* p, volatile int* q) {
  Read(y, None, Relaxed, C, r1);
  Read(q, None, Relaxed, C, r2);
  Write(p, 1, Release, C);
  Write(x, 1, Release, C);
}

exists (p=1 /\ q=1 /\ r0=1 /\ t=1 /\ r1=1 /\ r2=1)