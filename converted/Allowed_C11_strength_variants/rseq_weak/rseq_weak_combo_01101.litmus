P0 (atomic_int* x) {
  Write(x, 2, Release, C);
}

P1 (atomic_int* x, volatile int* y) {
  Write(y, 1, Relaxed, C);
  Write(x, 1, Release, C);
  Write(x, 3, Release, C);
}

P2 (atomic_int* x, volatile int* y) {
  Read(x, None, Relaxed, C, r0);
  Read(y, None, Relaxed, C);
}

exists (x=3 /\ y=1 /\ r0=3)
