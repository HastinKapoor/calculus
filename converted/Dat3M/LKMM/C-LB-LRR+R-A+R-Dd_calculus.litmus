{ [x2] = y2; }

P0(u0, x1) {
	Read(u0, None, Relaxed, Linux, r0);
	Write(x1, 1, Release, Linux, None);
}

P1(u0, x1, x2) {
	Read(x1, None, Acquire, Linux, r1);
	Write(x2, u0, Release, Linux, None);
}

P2(x2) {
	Read(x2, None, Acquire, Linux, r2);
	Read(r1, None, Relaxed, Linux, r3);
}

P3(u0) {
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r3=0 /\ r1=1 /\ r3=u0)
