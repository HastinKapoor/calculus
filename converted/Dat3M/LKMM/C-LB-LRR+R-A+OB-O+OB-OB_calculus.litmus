P0(u0, x1) {
	Read(u0, None, Relaxed, Linux, r0);
	Write(x1, 1, Release, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Acquire, Linux, r1);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x2, 1, Relaxed, Linux, None);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r2);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x3, 1, Relaxed, Linux, None);
}

P3(x3, u0) {
	Read(x3, None, Relaxed, Linux, r3);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(u0, None, Relaxed, Linux, r4);
}

P4(u0) {
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r4=0 /\ r1=1 /\ r2=1 /\ r3=1)
