P0(x0, x1) {
	Read(x0, None, Relaxed, Linux, r0);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(x1, None, Relaxed, Linux, r1);
}

P1(x1, x2) {
	Read(x1, None, Relaxed, Linux, r2);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(x2, None, Relaxed, Linux, r3);
}

P2(x2, x0) {
	Read(x2, None, Relaxed, Linux, r4);
	Read(x0, None, Relaxed, Linux, r5);
}

P3(x0, x1, x2) {
	Write(x0, 1, Relaxed, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
	Write(x2, 1, Relaxed, Linux, None);
}

exists (r5=0 /\ r0=1 /\ r1=0 /\ r2=1 /\ r3=0 /\ r4=1)
