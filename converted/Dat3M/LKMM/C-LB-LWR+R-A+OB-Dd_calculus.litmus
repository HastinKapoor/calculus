{ [x2] = y2; }

P0(u0, x1) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, 1, Release, Linux, None);
}

P1(u0, x1, x2) {
	Read(x1, None, Acquire, Linux, r0);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x2, u0, Relaxed, Linux, None);
}

P2(x2) {
	Read(x2, None, Acquire, Linux, r1);
	Read(r1, None, Relaxed, Linux, r2);
}

exists (r2=0 /\ r0=1 /\ r1=u0)
