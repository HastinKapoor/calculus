P0(u0, x1) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, 1, Release, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Acquire, Linux, r0);
	Write(x2, 1, Release, Linux, None);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r1);
}

P3(x3, x4) {
	Read(x3, None, Relaxed, Linux, r2);
}

P4(x4, u0) {
	Read(x4, None, Relaxed, Linux, r3);
	Fence(None, None, Seq_cst, Linux, None);
	Write(u0, 1, Relaxed, Linux, None);
}

exists (u0=3 /\ r0=1 /\ r1=1 /\ r2=1 /\ r3=1)
