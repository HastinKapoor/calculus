{ [x1] = y1; [x3] = y3; }

P0(u0, x1, x2) {
	Read(u0, None, Relaxed, Linux, r0);
	Write(x1, x2, Release, Linux, None);
}

P1(x1) {
	Read(x1, None, Acquire, Linux, r1);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(r1, 1, Relaxed, Linux, None);
}

P2(x2, x3, x4) {
	Read(x2, None, Relaxed, Linux, r2);
	Write(x3, x4, Release, Linux, None);
}

P3(x3) {
	Read(x3, None, Acquire, Linux, r3);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(r1, 1, Relaxed, Linux, None);
}

P4(v0, x4) {
	Read(x4, None, Relaxed, Linux, r4);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(v0, None, Relaxed, Linux, r5);
}

P5(u0, v0) {
	Write(v0, 1, Relaxed, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r5=0 /\ r0=1 /\ r1=x2 /\ r2=1 /\ r3=x4 /\ r4=1)
