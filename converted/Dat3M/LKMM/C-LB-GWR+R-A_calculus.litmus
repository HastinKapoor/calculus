P0(u0, x1) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, 1, Release, Linux, None);
}

P1(v0, x1) {
	Read(x1, None, Acquire, Linux, r0);
	Read(v0, None, Relaxed, Linux, r1);
}

P2(u0, v0) {
	Write(v0, 1, Relaxed, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(u0, None, Relaxed, Linux, r2);
}

exists (r1=0 /\ r2=0 /\ r0=1)
