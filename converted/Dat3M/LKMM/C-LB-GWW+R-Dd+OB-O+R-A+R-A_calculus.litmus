{ [x1] = y1; }

P0(u0, x1, x2) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, x2, Release, Linux, None);
}

P1(x1) {
	Read(x1, None, Acquire, Linux, r0);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(r1, 1, Relaxed, Linux, None);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r1);
	Write(x3, 1, Release, Linux, None);
}

P3(x3, x4) {
	Read(x3, None, Acquire, Linux, r2);
	Write(x4, 1, Release, Linux, None);
}

P4(v0, x4) {
	Read(x4, None, Acquire, Linux, r3);
	Write(v0, 1, Relaxed, Linux, None);
}

P5(u0, v0) {
	Read(v0, None, Relaxed, Linux, r4);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(u0, None, Relaxed, Linux, r5);
}

exists (r4=1 /\ r5=0 /\ r0=x2 /\ r1=1 /\ r2=1 /\ r3=1)
