{ [x1] = y1; [x2] = y2; [x3] = y3; }

P0(u0, x1, x2) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, x2, Release, Linux, None);
}

P1(x1, x3) {
	Read(x1, None, Acquire, Linux, r0);
	Write(r1, x3, Release, Linux, None);
}

P2(x2, v0) {
	Read(x2, None, Acquire, Linux, r1);
	Write(r1, v0, Release, Linux, None);
}

P3(x3) {
	Read(x3, None, Acquire, Linux, r2);
	Read(r1, None, Relaxed, Linux, r3);
}

P4(v0, u0) {
	Write(v0, 1, Relaxed, Linux, None);
	Fence(None, None, SEQ_CST, Linux, None);
	Read(u0, None, Relaxed, Linux, r4);
}

exists (r3=0 /\ r4=0 /\ r0=x2 /\ r1=x3 /\ r2=v0)
