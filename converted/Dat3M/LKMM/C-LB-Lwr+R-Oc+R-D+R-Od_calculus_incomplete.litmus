{ [x3] = y3; }

P0(u0, x1) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, 1, Release, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Relaxed, Linux, r0);
}

P2(x2, x3, u0) {
	Read(x2, None, Acquire, Linux, r1);
	Write(x3, u0, Release, Linux, None);
}

P3(x3) {
	Read(x3, None, Relaxed, Linux, r2);
	Read(r1, None, Relaxed, Linux, r3);
}

exists (r3=0 /\ r0=1 /\ r1=1 /\ r2=u0)
