P0(u0, x1) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, 1, Release, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Relaxed, Linux, r0);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r1);
}

P3(x3, x4) {
	Read(x3, None, Relaxed, Linux, r2);
}

P4(v0, x4) {
	Read(x4, None, Relaxed, Linux, r3);
	Fence(None, None, Seq_cst, Linux, None);
	Write(v0, 1, Relaxed, Linux, None);
}

P5(u0, v0) {
	Read(v0, None, Relaxed, Linux, r4);
	Fence(None, None, Seq_cst, Linux, None);
	Read(u0, None, Relaxed, Linux, r5);
}

exists (r4=1 /\ r5=0 /\ r0=1 /\ r1=1 /\ r5=1 /\ r3=1)
