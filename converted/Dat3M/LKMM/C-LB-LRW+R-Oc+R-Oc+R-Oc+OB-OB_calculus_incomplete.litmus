P0(u0, x1) {
	Read(u0, None, Relaxed, Linux, r0);
	Write(x1, 1, Release, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Relaxed, Linux, r1);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r2);
}

P3(x3, x4) {
	Read(x3, None, Relaxed, Linux, r3);
}

P4(x4, u0) {
	Read(x4, None, Relaxed, Linux, r4);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r1=1 /\ r2=1 /\ r3=1 /\ r4=1)
