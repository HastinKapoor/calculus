{ [x1] = y1; [x3] = y3; }

P0(u0, x1, x2) {
	Write(u0, 3, Relaxed, Linux, None);
	Write(x1, x2, Release, Linux, None);
}

P1(x1) {
	Read(x1, None, Acquire, Linux, r0);
	Write(r1, 1, Release, Linux, None);
}

P2(x2, x3, x4) {
	Read(x2, None, Acquire, Linux, r1);
	Write(x3, x4, Release, Linux, None);
}

P3(x3) {
	Read(x3, None, Acquire, Linux, r2);
	Write(r1, 1, Release, Linux, None);
}

P4(x4, u0) {
	Read(x4, None, Acquire, Linux, r3);
	Write(u0, 1, Relaxed, Linux, None);
}

exists (u0=3 /\ r0=x2 /\ r1=1 /\ r2=x4 /\ r3=1)
