{ [x2] = y3; }

P0(x0, x1) {
	Read(x0, None, Relaxed, Linux, r0);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
}

P1(x1, x2, x3) {
	Read(x1, None, Relaxed, Linux, r1);
	Write(x2, x3, Release, Linux, None);
}

P2(x2, y3) {
	Read(x2, None, Acquire, Linux, r2);
	Write(r1, 1, Relaxed, Linux, None);
}

P3(x3, x4) {
	Read(x3, None, Relaxed, Linux, r3);
	Write(x4, 1, Relaxed, Linux, None);
}

P4(x4, x5) {
	Read(x4, None, Relaxed, Linux, r4);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x5, 1, Relaxed, Linux, None);
}

P5(x5, x6) {
	Read(x5, None, Relaxed, Linux, r5);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x6, 1, Relaxed, Linux, None);
}

P6(x6, x7) {
	Read(x6, None, Relaxed, Linux, r6);
	Write(x7, 1, Relaxed, Linux, None);
}

P7(x7, x0) {
	Read(x7, None, Relaxed, Linux, r7);
	Write(x0, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r1=1 /\ r2=x3 /\ r3=1 /\ r4=1 /\ r5=1 /\ r6=1 /\ r7=1)
