{ [x1] = y1; }

P0(u0, x1, x2) {
	Read(u0, None, Relaxed, Linux, r0);
	Write(x1, x2, Release, Linux, None);
}

P1(x1) {
	Read(x1, None, Acquire, Linux, r1);
	Write(r1, 1, Release, Linux, None);
}

P2(x2, v0) {
	Read(x2, None, Acquire, Linux, r2);
	Read(v0, None, Relaxed, Linux, r3);
}

P3(u0, v0) {
	Write(v0, 1, Relaxed, Linux, None);
	Fence(None, None, Seq_cst, Linux, None);
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r3=0 /\ r0=1 /\ r1=x2 /\ r2=1)
