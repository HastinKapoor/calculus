{ [x2] = y0; }

P0(x0, x1) {
	Read(x0, None, Relaxed, Linux, r0);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
}

P1(x0, x1, x2) {
	Read(x1, None, Relaxed, Linux, r1);
	Write(x2, x0, Release, Linux, None);
}

P2(x2, y0) {
	Read(x2, None, Acquire, Linux, r2);
}

exists (r0=1 /\ r1=1 /\ r2=x0)
