{ [x4] = y5; }

P0(x0, x1) {
	Read(x0, None, Relaxed, Linux, r0);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Relaxed, Linux, r1);
	Write(x2, 1, Relaxed, Linux, None);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r2);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x3, 1, Relaxed, Linux, None);
}

P3(x3, x4, x5) {
	Read(x3, None, Relaxed, Linux, r3);
	Write(x4, x5, Release, Linux, None);
}

P4(x4, y5) {
	Read(x4, None, Acquire, Linux, r4);
	Write(r1, 1, Relaxed, Linux, None);
}

P5(x5, x6) {
	Read(x5, None, Relaxed, Linux, r5);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x6, 1, Relaxed, Linux, None);
}

P6(x6, x0) {
	Read(x6, None, Relaxed, Linux, r6);
	Write(x0, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r1=1 /\ r2=1 /\ r3=1 /\ r4=x5 /\ r5=1 /\ r6=1)
