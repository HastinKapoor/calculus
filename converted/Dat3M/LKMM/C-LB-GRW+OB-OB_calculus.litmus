P0(u0, x1) {
	Read(u0, None, Relaxed, Linux, r0);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
}

P1(v0, x1) {
	Read(x1, None, Relaxed, Linux, r1);
	Fence(None, None, Seq_cst, Linux, None);
	Write(v0, 1, Relaxed, Linux, None);
}

P2(u0, v0) {
	Read(v0, None, Relaxed, Linux, r2);
	Fence(None, None, Seq_cst, Linux, None);
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r2=1 /\ r0=1 /\ r1=1)
