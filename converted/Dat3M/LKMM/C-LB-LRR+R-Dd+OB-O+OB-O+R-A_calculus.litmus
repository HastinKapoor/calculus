{ [x1] = y1; }

P0(u0, x1, x2) {
	Read(u0, None, Relaxed, Linux, r0);
	Write(x1, x2, Release, Linux, None);
}

P1(x1) {
	Read(x1, None, Acquire, Linux, r1);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(r1, 1, Relaxed, Linux, None);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r2);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x3, 1, Relaxed, Linux, None);
}

P3(x3, x4) {
	Read(x3, None, Relaxed, Linux, r3);
	Write(x4, 1, Release, Linux, None);
}

P4(x4, u0) {
	Read(x4, None, Acquire, Linux, r4);
	Read(u0, None, Relaxed, Linux, r5);
}

P5(u0) {
	Write(u0, 1, Relaxed, Linux, None);
}

exists (r0=1 /\ r5=0 /\ r1=x2 /\ r2=1 /\ r3=1 /\ r4=1)
