{ [x5] = y0; }

P0(x0, x1) {
	Read(x0, None, Relaxed, Linux, r0);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
}

P1(x1, x2) {
	Read(x1, None, Relaxed, Linux, r1);
	Write(x2, 1, Relaxed, Linux, None);
}

P2(x2, x3) {
	Read(x2, None, Relaxed, Linux, r2);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x3, 1, Relaxed, Linux, None);
}

P3(x3, x4) {
	Read(x3, None, Relaxed, Linux, r3);
	Fence(None, None, SEQ_CST, Linux, None);
	Write(x4, 1, Relaxed, Linux, None);
}

P4(x0, x4, x5) {
	Read(x4, None, Relaxed, Linux, r4);
	Write(x5, x0, Release, Linux, None);
}

P5(y0, x5) {
	Read(x5, None, Acquire, Linux, r5);
}

exists (r0=1 /\ r1=1 /\ r2=1 /\ r3=1 /\ r4=1 /\ r5=x0)
