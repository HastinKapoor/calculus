P0(x0, x1) {
	Write(x0, 2, Relaxed, Linux, None);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x1, 1, Relaxed, Linux, None);
}

P1(x1, x2) {
	Write(x1, 2, Relaxed, Linux, None);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x2, 1, Relaxed, Linux, None);
}

P2(x2, x3) {
	Write(x2, 2, Relaxed, Linux, None);
	Fence(None, None, Seq_cst, Linux, None);
	Write(x3, 1, Relaxed, Linux, None);
}

P3(x0, x3) {
	Write(x3, 2, Relaxed, Linux, None);
	Write(x0, 1, Relaxed, Linux, None);
}

exists (x0=2 /\ x1=2 /\ x2=2 /\ x3=2)
