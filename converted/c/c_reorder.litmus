{ [x] = 0; [y] = 0; [p] = 0; [q] = 0; }

P0(){
Read(x, None, Relaxed, C, r0_T0);
if (r0_T0) {
Write(q, 1, Relaxed, C, None);
Read(p, None, Relaxed, C, t_T0);
if (t_T0) {
Write(y, 1, Relaxed, C, None);
}
}
}

P1(){
Read(y, None, Relaxed, C, r1_T1);
if (r1_T1) {
Read(q, None, Relaxed, C, r2_T1);
if (r2_T1) {
Write(p, 1, Relaxed, C, None);
Write(x, 1, Relaxed, C, None);
}
}
}

exists (p=1 /\ q=1)
